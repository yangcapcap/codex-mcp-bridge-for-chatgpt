{
  "name": "codex-mcp-bridge-for-chatgpt",
  "version": "0.4.1",
  "packageManager": "npm@10.9.3",
  "description": "A policy-enforcing Streamable HTTP MCP bridge from ChatGPT to local Codex.",
  "type": "module",
  "bin": {
    "codex-mcp-bridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "UPSTREAM.md",
    "docs",
    "scripts/auth-selection.mjs",
    "scripts/auth-selection.d.mts",
    "scripts/build-fingerprint.mjs",
    "scripts/child-shutdown.mjs",
    "scripts/launcher-options.mjs",
    "scripts/managed-file.mjs",
    "scripts/managed-file.d.mts",
    "scripts/runtime-env.mjs",
    "scripts/runtime-lock.mjs",
    "scripts/runtime-status.mjs",
    "scripts/runtime-status.d.mts",
    "scripts/start-codex-mcp-bridge.mjs",
    "scripts/text-integrity.d.mts",
    "scripts/text-integrity.mjs",
    "scripts/tunnel-profile.mjs",
    ".codex-plugin",
    ".app.json",
    "release-manifest.json",
    "release-manifest.schema.json",
    "ui-release-catalog.json",
    "state-migrations.json"
  ],
  "scripts": {
    "app-server:compat:check": "tsx scripts/app-server-schema.ts check",
    "app-server:compat:update": "tsx scripts/app-server-schema.ts update",
    "localization:generate": "tsx scripts/localization.mts generate",
    "localization:check": "tsx scripts/localization.mts check",
    "release:check": "npm run localization:check && node scripts/release-manifest.mjs check && node scripts/release-policy.mjs check",
    "release:sync": "node scripts/release-manifest.mjs sync",
    "release:plan": "node scripts/release-policy.mjs plan",
    "release:prepare-candidate": "node scripts/release-policy.mjs prepare-candidate",
    "release:next-rc": "node scripts/release-policy.mjs next-rc",
    "release:promote": "node scripts/release-policy.mjs promote",
    "release:development": "node scripts/release-policy.mjs development",
    "release:assets": "node scripts/release-assets.mjs",
    "release:payload": "node scripts/release-payload.mjs",
    "validate:fast": "npm run release:check && npm run app-server:compat:check",
    "validate:affected": "node scripts/release-validation.mjs affected",
    "validate:full": "npm run check && npm run app-server:compat:check && npm run macos:check",
    "validate:candidate": "node scripts/release-policy.mjs assert-stage candidate && npm run validate:full",
    "validate:stable": "node scripts/release-policy.mjs assert-stage stable && npm run validate:full",
    "build": "npm run release:check && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node scripts/write-build-info.mjs",
    "macos:localizations:check": "npm run localization:check && ./macos/check-localizations.sh",
    "macos:localizations:sync": "npm run localization:generate && ./macos/sync-localizations.sh",
    "macos:check": "npm run macos:localizations:check && swift test --package-path macos -Xswiftc -strict-concurrency=complete -Xswiftc -warnings-as-errors",
    "macos:settings-visual:check": "tsx scripts/native-settings-connection-visual-acceptance.ts",
    "macos:skills-visual:check": "tsx scripts/native-skill-library-visual-acceptance.ts",
    "macos:bundle": "./macos/build-app.sh",
    "macos:package": "./macos/package-release.sh",
    "bridge:local": "node scripts/start-codex-mcp-bridge.mjs --mode local",
    "bridge:secure": "node scripts/start-codex-mcp-bridge.mjs --mode secure",
    "bridge:secure:stdio": "node scripts/start-codex-mcp-bridge.mjs --mode secure --transport stdio",
    "bridge:secure:write": "node scripts/start-codex-mcp-bridge.mjs --mode secure --write",
    "bridge:secure:allow-write": "node scripts/start-codex-mcp-bridge.mjs --mode secure --allow-write",
    "bridge:secure:allow-full-access": "node scripts/start-codex-mcp-bridge.mjs --mode secure --allow-full-access",
    "dev": "tsx src/cli.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "start": "node dist/cli.js",
    "start:stdio": "node dist/stdio.js",
    "test": "vitest run --maxWorkers=4",
    "test:dashboard-scope-browser": "tsx scripts/dashboard-scope-browser-regression.ts",
    "test:dashboard-summary-browser": "tsx scripts/dashboard-summary-browser-regression.ts",
    "test:issue-125-r1-card": "tsx scripts/issue-125-r1-card-delivery-regression.ts",
    "test:issue-126-live-card": "tsx scripts/issue-126-live-card-completion-regression.ts",
    "test:issue-137-status-wait": "tsx scripts/issue-137-status-wait-regression.ts",
    "test:issue-138-state-access": "tsx scripts/issue-138-state-access-regression.ts",
    "test:issue-185-execution-recovery": "tsx scripts/issue-185-execution-recovery-regression.ts",
    "test:issue-186-observation": "tsx scripts/issue-186-observation-regression.ts",
    "test:issue-189-retention": "tsx scripts/issue-189-retention-regression.ts",
    "test:issue-197-storage": "tsx scripts/issue-197-storage-probe.ts",
    "test:issue-198:quick": "node scripts/issue-198-validation.mjs quick",
    "test:issue-198:integrated": "node scripts/issue-198-validation.mjs integrated",
    "test:issue-198:installed": "node scripts/issue-198-validation.mjs installed",
    "test:issue-212-card": "tsx scripts/issue-212-dashboard-usage-browser-regression.ts",
    "test:issue-142-state-execution-isolation": "tsx scripts/issue-142-state-execution-isolation-regression.ts",
    "test:issue-143-connection-reliability": "npm run test:issue-143-connection-reliability:characterization",
    "test:issue-143-connection-reliability:characterization": "tsx scripts/issue-143-connection-reliability-regression.ts",
    "test:issue-143-card-stale": "tsx scripts/issue-143-card-stale-browser-regression.ts",
    "test:issue-143-native-companion": "tsx scripts/issue-143-native-companion-contract.ts",
    "test:issue-154-direct-result": "vitest run test/userSettings.test.ts test/stateStore.test.ts test/tools.test.ts -t 'direct-result|direct-wait' --maxWorkers=1 && npm run test:issue-126-live-card",
    "test:model-descriptions-browser": "tsx scripts/model-description-browser-regression.ts",
    "mcp:conformance": "npm run build && node scripts/mcp-conformance.mjs",
    "check": "npm run build && npm run test",
    "macos:remote:check": "tsx scripts/check-native-remote.ts",
    "test:continuity": "node scripts/check-thread-continuity.mjs",
    "test:launchd-lifecycle": "tsx scripts/check-launchd-lifecycle.ts --run-isolated"
  },
  "keywords": [
    "codex",
    "chatgpt",
    "mcp",
    "model-context-protocol",
    "bridge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/menaje/codex-mcp-bridge-for-chatgpt.git"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@noble/curves": "2.3.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.7",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "standardwebhooks": "^1.1.1",
    "tar": "7.5.22",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.12.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/menaje/codex-mcp-bridge-for-chatgpt#readme",
  "bugs": {
    "url": "https://github.com/menaje/codex-mcp-bridge-for-chatgpt/issues"
  }
}
